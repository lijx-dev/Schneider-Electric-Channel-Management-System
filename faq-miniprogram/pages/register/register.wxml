<view class="register-page">
  <view class="hero-card">
    <view class="hero-backdrop"></view>
    <view class="hero-content">
      <view class="hero-copy">
        <text class="hero-title">完善个人信息</text>
        <text class="hero-subtitle">请先同步微信头像，再完成实名认证信息。</text>
      </view>

      <button class="hero-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseWechatAvatar" loading="{{isUploadingAvatar}}">
        <image class="hero-avatar" src="{{userInfo.avatar_url || '/images/default-avatar.svg'}}" mode="aspectFill"></image>
        <view class="hero-avatar-edit">更换头像</view>
      </button>
    </view>
  </view>

  <view class="register-card">
    <view class="card-head">
      <text class="card-title">认证信息</text>
      <text class="card-subtitle">信息仅用于分销商身份识别与学习服务匹配</text>
    </view>

    <view class="form-item">
      <text class="form-label">姓名</text>
      <input
        class="form-input"
        placeholder="请输入真实姓名"
        placeholder-class="input-placeholder"
        value="{{realName}}"
        bindinput="onRealNameInput"
      />
    </view>

    <picker mode="selector" range="{{provinceList}}" value="{{provinceIndex}}" bindchange="onProvinceChange">
      <view class="form-item form-item-picker">
        <text class="form-label">省份</text>
        <view class="picker-value-wrap">
          <text class="picker-value {{selectedProvince ? '' : 'placeholder'}}">{{selectedProvince || '请选择省份'}}</text>
          <text class="picker-arrow">></text>
        </view>
      </view>
    </picker>

    <picker
      mode="selector"
      range="{{companyList}}"
      value="{{companyIndex}}"
      bindchange="onCompanyChange"
      disabled="{{!selectedProvince || loadingCompanies}}"
    >
      <view class="form-item form-item-picker {{!selectedProvince || loadingCompanies ? 'disabled' : ''}}">
        <text class="form-label">公司</text>
        <view class="picker-value-wrap">
          <text class="picker-value {{selectedCompany ? '' : 'placeholder'}}">{{selectedCompany || companyPlaceholder}}</text>
          <text class="picker-arrow">></text>
        </view>
      </view>
    </picker>

    <view class="form-note">
      <text class="form-note-text">省份已统一标准化展示，选择后会自动联动该省份的分销商公司。</text>
    </view>
  </view>

  <button class="submit-btn" bindtap="submitAuth">提交认证</button>
</view>
