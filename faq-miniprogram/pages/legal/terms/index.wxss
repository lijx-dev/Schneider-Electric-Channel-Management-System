.legal-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(16, 185, 129, 0.14), transparent 28%),
    linear-gradient(180deg, #f3fbf6 0%, #ffffff 20%);
}

.legal-hero {
  padding: 44rpx 32rpx 28rpx;
}

.legal-kicker {
  display: block;
  color: #10b981;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.legal-title {
  display: block;
  margin-top: 14rpx;
  color: #0f172a;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.2;
}

.legal-meta {
  display: block;
  margin-top: 10rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.4;
}

.legal-card {
  margin: 0 24rpx 36rpx;
  padding: 30rpx 24rpx 8rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 16rpx 32rpx rgba(15, 23, 42, 0.06);
  border: 1rpx solid rgba(16, 185, 129, 0.08);
}

.legal-lead {
  display: block;
  color: #334155;
  font-size: 26rpx;
  line-height: 1.8;
}

.legal-section {
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(226, 232, 240, 0.8);
}

.legal-section-last {
  padding-bottom: 28rpx;
}

.legal-heading {
  display: block;
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.5;
}

.legal-paragraph {
  display: block;
  margin-top: 14rpx;
  color: #475569;
  font-size: 24rpx;
  line-height: 1.85;
}
