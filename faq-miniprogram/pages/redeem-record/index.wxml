<view class="page">
  <view class="hero-card">
    <view class="hero-header">
      <view>
        <text class="hero-eyebrow">Redeem Records</text>
        <text class="hero-title">兑换记录</text>
      </view>
      <view class="hero-chip">
        <text class="hero-chip-label">待确认</text>
        <text class="hero-chip-value">{{summary.pending}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{false}}" class="summary-grid">
    <view class="summary-card">
      <text class="summary-label">记录数</text>
      <text class="summary-value">{{summary.total}}</text>
    </view>
    <view class="summary-card">
      <text class="summary-label">已消耗</text>
      <text class="summary-value">{{summary.spent}}</text>
    </view>
  </view>

  <view class="record-empty" wx:if="{{!loading && !records.length}}">
    <text class="record-empty-title">还没有兑换记录</text>
    <text class="record-empty-copy">去能量商城兑换后，这里会自动同步显示。</text>
    <button class="mall-btn" hover-class="none" bindtap="goToMall">去兑换</button>
  </view>

  <view class="record-list" wx:else>
    <view class="record-card" wx:for="{{records}}" wx:for-item="item" wx:key="id">
      <view class="record-top">
        <text class="record-name">{{item.titleText}}</text>
        <text class="record-status">{{item.statusText}}</text>
      </view>
      <view class="record-bottom">
        <text class="record-meta">{{item.costText}}</text>
        <text class="record-meta">{{item.createdAtText}}</text>
      </view>
    </view>
  </view>
</view>
