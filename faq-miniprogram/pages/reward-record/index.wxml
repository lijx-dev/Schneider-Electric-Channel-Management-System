<view class="page">
  <view class="tabs">
    <view
      class="tab {{currentType === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-type="{{item.key}}"
      bindtap="switchType"
    >
      <text>{{item.text}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{records.length}}" class="record-list">
    <view class="record-card" wx:for="{{records}}" wx:key="id">
      <view class="record-main">
        <view class="record-title-row">
          <text class="record-title">{{item.title || item.typeText}}</text>
          <text class="record-amount">{{item.amountText}}</text>
        </view>
        <text class="record-desc">{{item.description}}</text>
        <view class="record-meta">
          <text>{{item.typeText}}</text>
          <text wx:if="{{item.timeText}}">{{item.timeText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="empty">
    <text class="empty-title">暂无奖励记录</text>
    <text class="empty-subtitle">月榜结算或抽奖中奖后，会在这里显示。</text>
  </view>
</view>
