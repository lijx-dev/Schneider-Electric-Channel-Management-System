.page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f6faf7;
}

.tabs {
  display: flex;
  gap: 12rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  background: #ecfdf5;
  border-radius: 20rpx;
}

.tab {
  flex: 1;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #64748b;
}

.tab.active {
  color: #047857;
  background: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(15, 23, 42, 0.08);
}

.loading,
.empty {
  padding: 180rpx 30rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 28rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.record-card {
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.06);
}

.record-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.record-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.record-amount {
  font-size: 32rpx;
  font-weight: 800;
  color: #059669;
}

.record-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 36rpx;
  color: #475569;
}

.record-meta {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #94a3b8;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #334155;
}

.empty-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 36rpx;
}
