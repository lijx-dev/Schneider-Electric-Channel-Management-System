<view class="container">
  <view class="stats-banner card">
    <view class="stats-total">
      <text class="stats-number">{{totalCount}}</text>
      <text class="stats-label">题目总数</text>
    </view>
  </view>

  <view class="section-title">分类题库</view>
  <view class="type-list">
    <view
      class="type-card card"
      wx:for="{{categories}}"
      wx:key="category"
      bindtap="goToTypeList"
      data-category="{{item.category}}"
      data-name="{{item.label}}"
    >
      <view class="type-info">
        <text class="type-name">{{item.label}}</text>
        <text class="type-count">{{item.count}} 道题</text>
      </view>
      <text class="type-arrow">></text>
    </view>
  </view>
</view>
