.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #f0fdf4 0%, #f8fffb 28%, #f8fafc 100%);
}

.content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  padding: 30rpx 30rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.tab-card {
  margin-bottom: 26rpx;
}

.tab-switch {
  display: flex;
  padding: 8rpx;
  background: #ecfdf5;
  border-radius: 24rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 78rpx;
  border-radius: 18rpx;
}

.tab-item.active {
  background: #ffffff;
  box-shadow: 0 6rpx 14rpx rgba(15, 23, 42, 0.08);
}

.tab-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #047857;
}

.tab-text.muted {
  color: #64748b;
}

.loading-state {
  padding: 200rpx 0;
  text-align: center;
  color: #94a3b8;
  font-size: 30rpx;
}

.podium-area {
  margin-top: 10rpx;
  flex-shrink: 0;
}

.board-shell {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.month-head {
  margin: 0 0 16rpx;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.06);
}

.month-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.month-picker-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.month-picker-arrow {
  font-size: 22rpx;
  color: #64748b;
}

.month-rule-row {
  display: flex;
  align-items: flex-start;
  gap: 6rpx;
  margin-top: 8rpx;
}

.month-status-dot,
.month-status-text {
  font-size: 23rpx;
  line-height: 34rpx;
  font-weight: 700;
  color: #059669;
}

.month-rule {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  line-height: 34rpx;
  color: #64748b;
}

.month-empty {
  flex: 1;
}

.podium-top {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  min-height: 330rpx;
}

.podium-card {
  width: 164rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.podium-card.first {
  margin: 0 18rpx;
}

.podium-card.second,
.podium-card.third {
  padding-top: 70rpx;
}

.medal {
  min-width: 78rpx;
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #d1fae5;
  color: #047857;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-align: center;
  border: 2rpx solid #ffffff;
}

.first-medal {
  background: #059669;
  color: #ffffff;
  height: 48rpx;
  line-height: 48rpx;
}

.third-medal {
  background: #ecfdf5;
  color: #059669;
}

.podium-avatar {
  margin-top: 10rpx;
  width: 118rpx;
  height: 118rpx;
  border-radius: 999rpx;
  border: 6rpx solid #d1fae5;
  background: #ffffff;
}

.first-avatar {
  width: 148rpx;
  height: 148rpx;
  border-width: 8rpx;
  border-color: #10b981;
  box-shadow: 0 18rpx 32rpx rgba(16, 185, 129, 0.18);
}

.podium-name,
.champion-name {
  margin-top: 12rpx;
  max-width: 160rpx;
  font-size: 26rpx;
  color: #0f172a;
  font-weight: 600;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.champion-name {
  font-size: 31rpx;
}

.podium-company {
  margin-top: 6rpx;
  max-width: 164rpx;
  font-size: 20rpx;
  color: #94a3b8;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.champion-company {
  max-width: 180rpx;
}

.podium-score,
.champion-score {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #047857;
  font-weight: 700;
}

.champion-score {
  font-size: 27rpx;
  font-weight: 800;
}

.podium-time {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #64748b;
  font-weight: 500;
}

.champion-time {
  color: #475569;
}

.list-shell {
  flex: 1;
  min-height: 0;
  margin-top: 36rpx;
}

.list-scroll {
  height: 100%;
}

.list-card {
  padding: 8rpx 0;
  background: #ffffff;
  border-radius: 30rpx;
  box-shadow: 0 2rpx 4rpx rgba(15, 23, 42, 0.05);
  border: 2rpx solid #f1f5f9;
  overflow: hidden;
}

.rank-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 30rpx;
  border-top: 2rpx solid #f1f5f9;
}

.rank-row:first-child {
  border-top: none;
}

.rank-row.self {
  background: linear-gradient(90deg, rgba(16, 185, 129, 0.08) 0%, rgba(255, 255, 255, 0) 78%);
}

.rank-main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.rank-index {
  width: 42rpx;
  font-size: 26rpx;
  color: #94a3b8;
  font-weight: 700;
}

.rank-avatar {
  margin-left: 16rpx;
  width: 78rpx;
  height: 78rpx;
  border-radius: 999rpx;
  background: #ecfdf5;
}

.rank-meta {
  margin-left: 16rpx;
  min-width: 0;
}

.rank-name {
  display: block;
  font-size: 27rpx;
  color: #1e293b;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-company {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #94a3b8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-side {
  margin-left: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
}

.rank-score {
  font-size: 28rpx;
  color: #059669;
  font-weight: 700;
}

.rank-time {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #94a3b8;
  white-space: nowrap;
}

.my-rank-card {
  margin-top: 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 28rpx;
  background: linear-gradient(135deg, #08915f 0%, #047857 100%);
  border-radius: 30rpx;
  box-shadow: 0 20rpx 30rpx rgba(4, 120, 87, 0.2);
  flex-shrink: 0;
}

.my-rank-left {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.my-rank-avatar-ring {
  width: 86rpx;
  height: 86rpx;
  border-radius: 999rpx;
  background: rgba(254, 240, 138, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.my-rank-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.my-rank-copy {
  margin-left: 20rpx;
  min-width: 0;
  flex: 1;
}

.my-rank-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  min-width: 0;
  width: 100%;
  gap: 14rpx;
}

.my-rank-title {
  display: inline-block;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 0;
}

.my-rank-limit-note {
  margin-left: auto;
  color: rgba(236, 253, 245, 0.74);
  font-size: 20rpx;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
  flex-shrink: 0;
}

.my-rank-tip {
  display: block;
  margin-top: 8rpx;
  color: rgba(236, 253, 245, 0.92);
  font-size: 23rpx;
  line-height: 1.4;
}

.my-rank-score-wrap {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.my-rank-score {
  color: #ffffff;
  font-size: 50rpx;
  line-height: 1;
  font-weight: 800;
}

.my-rank-score-label {
  margin-top: 10rpx;
  color: rgba(236, 253, 245, 0.88);
  font-size: 18rpx;
  letter-spacing: 0;
  white-space: nowrap;
}

.company-board-head {
  margin-top: 12rpx;
  margin-bottom: 22rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.company-tab-shell {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.company-board-copy {
  flex: 1;
  min-width: 0;
}

.company-board-title {
  display: block;
  font-size: 34rpx;
  line-height: 1.3;
  color: #0f172a;
  font-weight: 700;
}

.company-board-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #64748b;
}

.company-board-pill {
  margin-left: 18rpx;
  min-width: 92rpx;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #dcfce7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.company-board-pill-text {
  color: #047857;
  font-size: 24rpx;
  font-weight: 700;
}

.company-list-shell {
  flex: 1;
  min-height: 0;
}

.company-list-scroll {
  height: 100%;
}

.company-list-card {
  background: #ffffff;
  border-radius: 34rpx;
  padding: 8rpx 0;
  border: 2rpx solid #eef2f7;
  box-shadow: 0 20rpx 32rpx rgba(15, 23, 42, 0.06);
  overflow: hidden;
}

.company-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 30rpx;
  border-top: 2rpx solid #f5f7fb;
}

.company-row:first-child {
  border-top: none;
}

.company-row.self {
  background: linear-gradient(90deg, rgba(16, 185, 129, 0.08) 0%, rgba(255, 255, 255, 0) 78%);
}

.company-row-left {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.company-rank {
  width: 40rpx;
  margin-right: 20rpx;
  text-align: center;
  font-size: 34rpx;
  color: #475569;
  font-weight: 700;
}

.company-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
}

.company-meta {
  margin-left: 18rpx;
  min-width: 0;
}

.company-name {
  display: block;
  font-size: 30rpx;
  color: #0f172a;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.company-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.company-score-wrap {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.company-score {
  font-size: 38rpx;
  line-height: 1;
  color: #059669;
  font-weight: 800;
}

.company-score-label {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #94a3b8;
  letter-spacing: 0;
  white-space: nowrap;
}

.company-self-card {
  margin-top: 18rpx;
  margin-bottom: 10rpx;
  padding: 26rpx 28rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #08915f 0%, #047857 100%);
  box-shadow: 0 20rpx 30rpx rgba(4, 120, 87, 0.2);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}

.company-self-left {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.company-self-avatar-ring {
  width: 86rpx;
  height: 86rpx;
  border-radius: 999rpx;
  background: rgba(254, 240, 138, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.company-self-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.company-self-copy {
  margin-left: 20rpx;
  min-width: 0;
}

.company-self-rank {
  display: block;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.company-self-tip {
  display: block;
  margin-top: 8rpx;
  color: rgba(236, 253, 245, 0.92);
  font-size: 23rpx;
  line-height: 1.4;
}

.company-self-score-wrap {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.company-self-score {
  color: #ffffff;
  font-size: 50rpx;
  line-height: 1;
  font-weight: 800;
}

.company-self-score-label {
  margin-top: 10rpx;
  color: rgba(236, 253, 245, 0.88);
  font-size: 18rpx;
  letter-spacing: 0;
  white-space: nowrap;
}

.empty-state {
  padding: 180rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 96rpx;
}

.empty-title {
  margin-top: 20rpx;
  font-size: 32rpx;
  color: #0f172a;
  font-weight: 600;
}

.empty-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #94a3b8;
  text-align: center;
  line-height: 1.6;
}
