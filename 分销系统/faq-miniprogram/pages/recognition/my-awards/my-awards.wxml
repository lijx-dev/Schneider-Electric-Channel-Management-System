<view class="page">
  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:else>
    <!-- 积分等级卡片（经理端不展示，个人积分为 0 无意义） -->
    <view wx:if="{{!isManager}}" class="level-card">
      <view class="level-header">
        <view class="level-badge">
          <text class="level-icon">{{level.level_icon}}</text>
          <text class="level-name">{{level.level}}</text>
        </view>
        <text class="level-score">{{totalScore}} 积分</text>
      </view>
      <view class="level-progress-bar">
        <view class="level-progress-fill" style="width: {{progressPercent}}%"></view>
      </view>
      <view wx:if="{{nextLevel}}" class="level-next">
        <text class="level-next-text">距离 {{nextLevel}} 还需 {{pointsToNext}} 积分</text>
      </view>
    </view>

    <!-- Tab 切换（经理端不展示积分明细） -->
    <view wx:if="{{!isManager}}" class="tab-bar">
      <view class="tab-item {{activeTab === 'awards' ? 'tab-active' : ''}}" data-tab="awards" bindtap="switchTab">
        <text>获奖记录</text>
      </view>
      <view class="tab-item {{activeTab === 'transactions' ? 'tab-active' : ''}}" data-tab="transactions" bindtap="switchTab">
        <text>积分明细</text>
      </view>
    </view>

    <!-- 经理端：全量评选结果（按奖项类型分组） -->
    <view wx:if="{{isManager}}" class="result-groups">
      <view wx:if="{{awardGroups.length === 0}}" class="empty-wrap">
        <text class="empty-text">暂无已发布的评选结果</text>
      </view>
      <view wx:for="{{awardGroups}}" wx:key="type" class="result-group">
        <view class="result-group-head">
          <text class="result-group-title">{{item.typeName}}</text>
          <text class="result-group-count">{{item.items.length}} 人</text>
        </view>
        <view wx:for="{{item.items}}" wx:for-item="award" wx:key="id" class="award-card">
          <view class="award-left">
            <text class="award-type">{{award.user_name}}</text>
            <text class="award-period">
              {{award.award_month || award.award_quarter || (award.award_year + '年')}}
            </text>
          </view>
          <view class="award-right">
            <text class="award-rank" wx:if="{{award.rank}}">第{{award.rank}}名</text>
            <text class="award-points">+{{award.points_awarded}} 积分</text>
            <text class="award-status">{{award.published ? '已发布' : '未发布'}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 获奖记录 -->
    <view wx:if="{{!isManager && activeTab === 'awards'}}" class="award-list">
      <view wx:if="{{awards.length === 0}}" class="empty-wrap">
        <text class="empty-text">暂无获奖记录</text>
      </view>
      <view wx:for="{{awards}}" wx:key="id" class="award-card">
        <view class="award-left">
          <text class="award-type">{{item.award_name}}</text>
          <text class="award-period">
            {{item.award_month || item.award_quarter || (item.award_year + '年')}}
          </text>
        </view>
        <view class="award-right">
          <text class="award-rank" wx:if="{{item.rank}}">第{{item.rank}}名</text>
          <text class="award-points">+{{item.points_awarded}} 积分</text>
        </view>
      </view>
    </view>

    <!-- 积分明细 -->
    <view wx:if="{{!isManager && activeTab === 'transactions'}}" class="transaction-list">
      <view wx:if="{{transactions.length === 0}}" class="empty-wrap">
        <text class="empty-text">暂无积分记录</text>
      </view>
      <view wx:for="{{transactions}}" wx:key="id" class="transaction-card">
        <view class="transaction-left">
          <text class="transaction-reason">{{item.reason}}</text>
          <text class="transaction-time">{{item.created_at}}</text>
        </view>
        <text class="transaction-points {{item.point_change > 0 ? 'points-positive' : 'points-negative'}}">
          {{item.point_change > 0 ? '+' : ''}}{{item.point_change}}
        </text>
      </view>
    </view>
  </view>
</view>