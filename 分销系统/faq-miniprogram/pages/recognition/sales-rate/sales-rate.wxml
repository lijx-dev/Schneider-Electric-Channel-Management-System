<view class="page">
  <view class="header">
    <text class="header-title">专员满意度评分</text>
    <text class="header-desc" wx:if="{{surveyMonth}}">评分月份：{{surveyMonth}}</text>
  </view>

  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:elif="{{submitted}}" class="submitted-wrap">
    <view class="submitted-icon-wrap">
      <text class="submitted-icon">✅</text>
    </view>
    <text class="submitted-title">本月已提交</text>
    <text class="submitted-desc">感谢您的反馈，评分已记录</text>
  </view>

  <view wx:elif="{{specialistList.length === 0}}" class="empty-wrap">
    <text class="empty-text">您暂无对接专员，无需评分</text>
  </view>

  <view wx:else class="specialist-list">
    <view wx:for="{{specialistList}}" wx:key="specialist_id" class="specialist-card">
      <view class="sp-header">
        <text class="sp-name">{{item.specialist_name}}</text>
        <text wx:if="{{item.scores}}" class="sp-rated">已评分</text>
      </view>

      <view wx:if="{{!item.scores}}">
        <!-- 响应效率 -->
        <view class="dimension-row">
          <text class="dim-label-text">响应效率</text>
          <text class="dim-desc">处理报备和问题的响应速度</text>
          <view class="score-options">
            <view
              wx:for="{{[0,1,2,3,4,5]}}"
              wx:key="*this"
              class="score-option {{((scores[item.specialist_id] || {}).efficiency || 0) === item ? 'score-option-active' : ''}}"
              data-specialist-id="{{item.specialist_id}}"
              data-dimension="efficiency"
              data-value="{{item}}"
              bindtap="onScoreTap"
            >
              <text class="score-num">{{item === 0 ? 'N/A' : item}}</text>
            </view>
          </view>
        </view>
        <!-- 问题解决 -->
        <view class="dimension-row">
          <text class="dim-label-text">问题解决</text>
          <text class="dim-desc">解决问题能力和专业程度</text>
          <view class="score-options">
            <view
              wx:for="{{[0,1,2,3,4,5]}}"
              wx:key="*this"
              class="score-option {{((scores[item.specialist_id] || {}).response || 0) === item ? 'score-option-active' : ''}}"
              data-specialist-id="{{item.specialist_id}}"
              data-dimension="response"
              data-value="{{item}}"
              bindtap="onScoreTap"
            >
              <text class="score-num">{{item === 0 ? 'N/A' : item}}</text>
            </view>
          </view>
        </view>
        <!-- 培训指导 -->
        <view class="dimension-row">
          <text class="dim-label-text">培训指导</text>
          <text class="dim-desc">提供产品知识培训质量</text>
          <view class="score-options">
            <view
              wx:for="{{[0,1,2,3,4,5]}}"
              wx:key="*this"
              class="score-option {{((scores[item.specialist_id] || {}).training || 0) === item ? 'score-option-active' : ''}}"
              data-specialist-id="{{item.specialist_id}}"
              data-dimension="training"
              data-value="{{item}}"
              bindtap="onScoreTap"
            >
              <text class="score-num">{{item === 0 ? 'N/A' : item}}</text>
            </view>
          </view>
        </view>
        <!-- 沟通协作 -->
        <view class="dimension-row">
          <text class="dim-label-text">沟通协作</text>
          <text class="dim-desc">沟通顺畅度和协作配合</text>
          <view class="score-options">
            <view
              wx:for="{{[0,1,2,3,4,5]}}"
              wx:key="*this"
              class="score-option {{((scores[item.specialist_id] || {}).communication || 0) === item ? 'score-option-active' : ''}}"
              data-specialist-id="{{item.specialist_id}}"
              data-dimension="communication"
              data-value="{{item}}"
              bindtap="onScoreTap"
            >
              <text class="score-num">{{item === 0 ? 'N/A' : item}}</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:else class="submitted-scores">
        <view class="submitted-score-row">
          <text class="submitted-dim">响应效率</text>
          <text class="submitted-val">{{item.scores.efficiency || 'N/A'}}</text>
        </view>
        <view class="submitted-score-row">
          <text class="submitted-dim">问题解决</text>
          <text class="submitted-val">{{item.scores.response || 'N/A'}}</text>
        </view>
        <view class="submitted-score-row">
          <text class="submitted-dim">培训指导</text>
          <text class="submitted-val">{{item.scores.training || 'N/A'}}</text>
        </view>
        <view class="submitted-score-row">
          <text class="submitted-dim">沟通协作</text>
          <text class="submitted-val">{{item.scores.communication || 'N/A'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && !submitted && specialistList.length > 0}}" class="bottom-bar">
    <view class="btn-submit {{submitting ? 'btn-disabled' : ''}}" bindtap="submitAllScores">
      <text wx:if="{{!submitting}}">提交评分</text>
      <text wx:else>提交中...</text>
    </view>
  </view>
</view>