<view class="page">
  <view class="header">
    <text class="header-title">销售对渠道专员满意度评分</text>
    <text class="header-desc" wx:if="{{surveyMonth}}">评分月份：{{surveyMonth}}（针对上月表现）</text>
    <view class="guide-bar" wx:if="{{!loading}}">
      <text class="guide-text">请选择上个月与你有对接过的渠道专员，逐位进行评分</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:elif="{{ratedCount > 0 && ratedCount >= displayList.length}}" class="submitted-wrap">
    <view class="submitted-icon-wrap">
      <text class="submitted-icon">✅</text>
    </view>
    <text class="submitted-title">评分已完成</text>
    <text class="submitted-desc">您已为全部渠道专员完成评分，感谢您的反馈</text>
  </view>

  <view wx:elif="{{displayList.length === 0}}" class="empty-wrap">
    <text class="empty-text">暂无可评分专员</text>
  </view>

  <view wx:else class="specialist-list">
    <view wx:for="{{displayList}}" wx:for-item="sp" wx:key="specialist_id" class="specialist-card {{sp.selected ? 'specialist-card-selected' : ''}}">

      <!-- 已评分：只读汇总 -->
      <view wx:if="{{sp.rated}}" class="sp-header">
        <text class="sp-name">{{sp.specialist_name}}</text>
        <text class="sp-rated">已评分</text>
      </view>
      <view wx:if="{{sp.rated}}" class="submitted-scores">
        <view class="submitted-score-row" wx:for="{{dims}}" wx:for-item="dim" wx:key="key">
          <text class="submitted-dim">{{dim.label}}</text>
          <text class="submitted-val">{{sp.scores[dim.key] || 'N/A'}}</text>
        </view>
      </view>

      <!-- 未评分：已选中，展开打分 -->
      <block wx:elif="{{sp.selected}}">
        <view class="sp-header">
          <text class="sp-name">{{sp.specialist_name}}</text>
          <text class="sp-select-link" data-specialist-id="{{sp.specialist_id}}" bindtap="onRemoveSelect">移除</text>
        </view>
        <view class="dimension-row" wx:for="{{dims}}" wx:for-item="dim" wx:key="key">
          <text class="dim-label-text">{{dim.label}}</text>
          <text class="dim-tip" wx:if="{{dim.noDistributorTip}}">{{dim.noDistributorTip}}</text>
          <view class="score-options">
            <view
              wx:for="{{scoreValues}}"
              wx:for-item="scoreVal"
              wx:key="*this"
              class="score-option {{scores[sp.specialist_id][dim.key] === scoreVal ? 'score-option-active' : ''}}"
              data-specialist-id="{{sp.specialist_id}}"
              data-dimension="{{dim.key}}"
              data-value="{{scoreVal}}"
              bindtap="onScoreTap"
            >
              <text class="score-num">{{scoreVal === 0 ? 'N/A' : scoreVal}}</text>
            </view>
          </view>
          <view class="anchor-list">
            <view class="anchor-item" wx:if="{{dim.anchors[5]}}">
              <text class="anchor-score">5分</text>
              <text class="anchor-text">{{dim.anchors[5]}}</text>
            </view>
            <view class="anchor-item" wx:if="{{dim.anchors[3]}}">
              <text class="anchor-score">3分</text>
              <text class="anchor-text">{{dim.anchors[3]}}</text>
            </view>
            <view class="anchor-item" wx:if="{{dim.anchors[1]}}">
              <text class="anchor-score">1分</text>
              <text class="anchor-text">{{dim.anchors[1]}}</text>
            </view>
          </view>
        </view>
      </block>

      <!-- 未评分：未选中，显示选择按钮 -->
      <view wx:else class="sp-header">
        <text class="sp-name">{{sp.specialist_name}}</text>
        <text class="sp-select-btn" data-specialist-id="{{sp.specialist_id}}" bindtap="onToggleSelect">选择评分</text>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && selectedCount > 0}}" class="bottom-bar">
    <view class="btn-submit {{submitting ? 'btn-disabled' : ''}}" bindtap="submitSelected">
      <text wx:if="{{!submitting}}">提交评分（{{selectedCount}}）</text>
      <text wx:else>提交中...</text>
    </view>
  </view>
</view>
