.about-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at top right, rgba(16, 185, 129, 0.14), transparent 28%),
    linear-gradient(180deg, #f4fbf7 0%, #ffffff 22%);
}

.about-hero {
  padding: 44rpx 32rpx 26rpx;
}

.about-kicker {
  display: block;
  color: #10b981;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.about-title {
  display: block;
  margin-top: 14rpx;
  color: #0f172a;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.2;
}

.about-desc {
  display: block;
  margin-top: 12rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.7;
}

.about-list {
  padding: 0 24rpx 36rpx;
}

.about-card {
  padding: 28rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(16, 185, 129, 0.08);
  box-shadow: 0 14rpx 28rpx rgba(15, 23, 42, 0.05);
}

.about-card + .about-card {
  margin-top: 18rpx;
}

.about-card-title {
  display: block;
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.55;
}

.about-card-content {
  display: block;
  margin-top: 14rpx;
  color: #475569;
  font-size: 24rpx;
  line-height: 1.85;
}
