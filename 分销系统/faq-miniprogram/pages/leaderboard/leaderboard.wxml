<view class="page">
  <view class="content">
    <view class="tab-card">
      <view class="tab-switch">
        <view class="tab-item {{currentTab === 'total' ? 'active' : ''}}" data-tab="total" bindtap="switchTab">
          <text class="tab-text {{currentTab !== 'total' ? 'muted' : ''}}">总累计榜</text>
        </view>
        <view class="tab-item {{currentTab === 'month' ? 'active' : ''}}" data-tab="month" bindtap="switchTab">
          <text class="tab-text {{currentTab !== 'month' ? 'muted' : ''}}">月榜</text>
        </view>
        <view class="tab-item {{currentTab === 'company' ? 'active' : ''}}" data-tab="company" bindtap="switchTab">
          <text class="tab-text {{currentTab !== 'company' ? 'muted' : ''}}">公司榜</text>
        </view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading-state">
      <text>加载中...</text>
    </view>

    <block wx:elif="{{currentTab === 'total' && totalHasData}}">
      <view class="board-shell">
        <view class="podium-area">
          <view class="podium-top">
            <view class="podium-card second" wx:if="{{topThree[1]}}">
              <view class="medal">2nd</view>
              <image class="podium-avatar" src="{{topThree[1].avatar}}" mode="aspectFill"></image>
              <text class="podium-name">{{topThree[1].nickname}}</text>
              <text class="podium-score">{{topThree[1].scoreText}}</text>
              <text class="podium-time">{{topThree[1].timeText}}</text>
            </view>

            <view class="podium-card first" wx:if="{{topThree[0]}}">
              <view class="medal first-medal">1st</view>
              <image class="podium-avatar first-avatar" src="{{topThree[0].avatar}}" mode="aspectFill"></image>
              <text class="champion-name">{{topThree[0].nickname}}</text>
              <text class="champion-score">{{topThree[0].scoreText}}</text>
              <text class="podium-time champion-time">{{topThree[0].timeText}}</text>
            </view>

            <view class="podium-card third" wx:if="{{topThree[2]}}">
              <view class="medal third-medal">3rd</view>
              <image class="podium-avatar" src="{{topThree[2].avatar}}" mode="aspectFill"></image>
              <text class="podium-name">{{topThree[2].nickname}}</text>
              <text class="podium-score">{{topThree[2].scoreText}}</text>
              <text class="podium-time">{{topThree[2].timeText}}</text>
            </view>
          </view>

        </view>

        <view class="list-shell">
          <scroll-view class="list-scroll" scroll-y enable-flex>
            <view class="list-card">
              <view class="rank-row {{item.isSelf ? 'self' : ''}}" wx:for="{{rankList}}" wx:key="user_id">
                <view class="rank-main">
                  <text class="rank-index">{{item.rankText}}</text>
                  <image class="rank-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
                  <view class="rank-meta">
                    <text class="rank-name">{{item.nickname}}</text>
                  </view>
                </view>
                <view class="rank-side">
                  <text class="rank-score">{{item.scoreText}}</text>
                  <text class="rank-time">{{item.timeText}}</text>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>

        <view class="my-rank-card" wx:if="{{myRank}}">
          <view class="my-rank-left">
            <view class="my-rank-avatar-ring">
              <image class="my-rank-avatar" src="{{myRank.avatar}}" mode="aspectFill"></image>
            </view>
            <view class="my-rank-copy">
              <view class="my-rank-title-row">
                <text class="my-rank-title">我的排名：{{myRank.rankValue || '--'}}</text>
                <text class="my-rank-limit-note">总榜仅展示前50名</text>
              </view>
              <text class="my-rank-tip">{{totalEncouragement}}</text>
            </view>
          </view>
          <view class="my-rank-score-wrap" wx:if="{{!myRank.ranking_excluded}}">
            <text class="my-rank-score">{{myRank.scoreText}}</text>
            <text class="my-rank-score-label">{{myRank.timeText}}</text>
          </view>
        </view>
      </view>
    </block>

    <block wx:elif="{{currentTab === 'month'}}">
      <view class="board-shell">
        <view class="month-head">
          <picker mode="multiSelector" range="{{monthPickerRange}}" value="{{monthPickerValue}}" bindchange="onMonthPickerChange" bindcolumnchange="onMonthPickerColumnChange">
            <view class="month-picker">
              <text class="month-picker-title">{{selectedMonthLabel}}</text>
              <text class="month-picker-arrow">▼</text>
            </view>
          </picker>
          <view class="month-rule-row">
            <text class="month-status-dot">·</text>
            <text class="month-status-text">{{monthStatusText}}</text>
            <text class="month-rule">{{monthRewardRuleText}}</text>
          </view>
        </view>

        <block wx:if="{{monthHasData}}">
        <view class="podium-area">
          <view class="podium-top">
            <view class="podium-card second" wx:if="{{monthLeaderboard[1]}}">
              <view class="medal">2nd</view>
              <image class="podium-avatar" src="{{monthLeaderboard[1].avatar}}" mode="aspectFill"></image>
              <text class="podium-name">{{monthLeaderboard[1].nickname}}</text>
              <text class="podium-score">{{monthLeaderboard[1].scoreText}}</text>
              <text class="podium-time">{{monthLeaderboard[1].timeText}}</text>
            </view>

            <view class="podium-card first" wx:if="{{monthLeaderboard[0]}}">
              <view class="medal first-medal">1st</view>
              <image class="podium-avatar first-avatar" src="{{monthLeaderboard[0].avatar}}" mode="aspectFill"></image>
              <text class="champion-name">{{monthLeaderboard[0].nickname}}</text>
              <text class="champion-score">{{monthLeaderboard[0].scoreText}}</text>
              <text class="podium-time champion-time">{{monthLeaderboard[0].timeText}}</text>
            </view>

            <view class="podium-card third" wx:if="{{monthLeaderboard[2]}}">
              <view class="medal third-medal">3rd</view>
              <image class="podium-avatar" src="{{monthLeaderboard[2].avatar}}" mode="aspectFill"></image>
              <text class="podium-name">{{monthLeaderboard[2].nickname}}</text>
              <text class="podium-score">{{monthLeaderboard[2].scoreText}}</text>
              <text class="podium-time">{{monthLeaderboard[2].timeText}}</text>
            </view>
          </view>
        </view>

        <view class="list-shell">
          <scroll-view class="list-scroll" scroll-y enable-flex>
            <view class="list-card">
              <view class="rank-row {{item.isSelf ? 'self' : ''}}" wx:for="{{monthRankList}}" wx:key="user_id">
                <view class="rank-main">
                  <text class="rank-index">{{item.rankText}}</text>
                  <image class="rank-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
                  <view class="rank-meta">
                    <text class="rank-name">{{item.nickname}}</text>
                  </view>
                </view>
                <view class="rank-side">
                  <text class="rank-score">{{item.scoreText}}</text>
                  <text class="rank-time">{{item.timeText}}</text>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>

        <view class="my-rank-card" wx:if="{{monthMyRank}}">
          <view class="my-rank-left">
            <view class="my-rank-avatar-ring">
              <image class="my-rank-avatar" src="{{monthMyRank.avatar}}" mode="aspectFill"></image>
            </view>
            <view class="my-rank-copy">
              <view class="my-rank-title-row">
                <text class="my-rank-title">我的排名：{{monthMyRank.rankValue || '--'}}</text>
                <text class="my-rank-limit-note">月榜仅展示前50名</text>
              </view>
              <text class="my-rank-tip">{{monthRankTip}}</text>
            </view>
          </view>
          <view class="my-rank-score-wrap" wx:if="{{!monthMyRank.ranking_excluded}}">
            <text class="my-rank-score">{{monthMyRank.scoreText}}</text>
            <text class="my-rank-score-label">{{monthMyRank.timeText}}</text>
          </view>
        </view>
        </block>

        <view wx:else class="empty-state month-empty">
          <text class="empty-icon">📳</text>
          <text class="empty-title">暂无月榜数据</text>
          <text class="empty-subtitle">这个月份还没有答题记录。</text>
        </view>
      </view>
    </block>

    <block wx:elif="{{currentTab === 'company' && companyHasData}}">
      <view class="company-tab-shell">
        <view class="company-board-head">
          <view class="company-board-copy">
            <text class="company-board-title">{{companyName || '公司榜'}}</text>
            <text class="company-board-subtitle">只显示同公司成员的实时排行</text>
          </view>
          <view class="company-board-pill" wx:if="{{companyMemberCount}}">
            <text class="company-board-pill-text">{{companyMemberCount}}人</text>
          </view>
        </view>

        <view class="company-list-shell">
          <scroll-view class="company-list-scroll" scroll-y enable-flex>
            <view class="company-list-card">
              <view class="company-row {{item.isSelf ? 'self' : ''}}" wx:for="{{companyLeaderboard}}" wx:key="user_id">
                <view class="company-row-left">
                  <text class="company-rank">{{item.companyRankText}}</text>
                  <image class="company-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
                  <view class="company-meta">
                    <text class="company-name">{{item.nickname}}</text>
                    <text class="company-subtitle">{{item.subtitle}}</text>
                  </view>
                </view>
                <view class="company-score-wrap">
                  <text class="company-score">{{item.scoreText}}</text>
                  <text class="company-score-label">{{item.timeText}}</text>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>

        <view class="company-self-card" wx:if="{{companyMyRank && companyName}}">
          <view class="company-self-left">
            <view class="company-self-avatar-ring">
              <image class="company-self-avatar" src="{{companyMyRank.avatar}}" mode="aspectFill"></image>
            </view>
            <view class="company-self-copy">
              <text class="company-self-rank">我的排名：{{companyMyRank.companyRankText}}</text>
              <text class="company-self-tip">{{companyEncouragement}}</text>
            </view>
          </view>
          <view class="company-self-score-wrap" wx:if="{{!companyMyRank.ranking_excluded}}">
            <text class="company-self-score">{{companyMyRank.scoreText}}</text>
            <text class="company-self-score-label">{{companyMyRank.timeText}}</text>
          </view>
        </view>
      </view>
    </block>

    <view wx:else class="empty-state">
      <text class="empty-icon">📳</text>
      <text class="empty-title">{{currentTab === 'company' ? '公司榜还没有数据' : '暂无排行榜数据'}}</text>
      <text class="empty-subtitle">
        {{currentTab === 'company' ? '先完善公司信息并开始答题，这里会自动显示同公司成员排行。' : '先去答题，成绩会出现在这里。'}}
      </text>
    </view>
  </view>
</view>
