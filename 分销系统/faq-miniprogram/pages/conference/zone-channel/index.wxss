.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.header {
  padding: 16rpx 8rpx 32rpx;
}

.header-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
}

.header-desc {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 10rpx;
  line-height: 1.6;
}

.step-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.step-card.step-done {
  background: #f0fdf4;
  border: 2rpx solid #00b050;
}

.step-status {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #00b050;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.step-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.step-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.step-desc {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

.step-btn {
  font-size: 26rpx;
  color: #00b050;
  background: #e8f7ee;
  border-radius: 999rpx;
  padding: 0 28rpx;
  margin: 0;
  line-height: 64rpx;
  height: 64rpx;
}

.step-btn::after {
  border: none;
}

.done-banner {
  margin-top: 24rpx;
  background: #d1fae5;
  border-radius: 20rpx;
  padding: 28rpx;
  text-align: center;
}

.done-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #065f46;
}

.loading {
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
  padding: 40rpx 0;
}
