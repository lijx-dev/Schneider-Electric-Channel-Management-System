<view class="page">
  <view class="header">
    <text class="header-title">渠道智能赋能展区</text>
    <text class="header-desc">完成以下全部 3 个步骤（需在同一天内完成），即可获得本展区能量印记</text>
  </view>

  <view class="step-card {{progress && progress.daily_quiz.done >= progress.daily_quiz.required ? 'step-done' : ''}}">
    <view class="step-status">{{progress && progress.daily_quiz.done >= progress.daily_quiz.required ? '✓' : '1'}}</view>
    <view class="step-info">
      <text class="step-title">完成每周答题</text>
      <text class="step-desc">本周已答 {{progress ? progress.daily_quiz.done : 0}}/{{progress ? progress.daily_quiz.required : 2}} 题</text>
    </view>
    <button class="step-btn" bindtap="goToWeeklyQuiz">去完成</button>
  </view>

  <view class="step-card {{progress && progress.ai_chat.done >= progress.ai_chat.required ? 'step-done' : ''}}">
    <view class="step-status">{{progress && progress.ai_chat.done >= progress.ai_chat.required ? '✓' : '2'}}</view>
    <view class="step-info">
      <text class="step-title">到母线豆包提问</text>
      <text class="step-desc">今日已提问 {{progress ? progress.ai_chat.done : 0}}/{{progress ? progress.ai_chat.required : 2}} 次</text>
    </view>
    <button class="step-btn" bindtap="goToAiChat">去完成</button>
  </view>

  <view class="step-card {{progress && progress.energy_view.done >= progress.energy_view.required ? 'step-done' : ''}}">
    <view class="step-status">{{progress && progress.energy_view.done >= progress.energy_view.required ? '✓' : '3'}}</view>
    <view class="step-info">
      <text class="step-title">浏览施能量页</text>
      <text class="step-desc">今日已浏览 {{progress ? progress.energy_view.done : 0}}/{{progress ? progress.energy_view.required : 1}} 次</text>
    </view>
    <button class="step-btn" bindtap="goToEnergyMall">去完成</button>
  </view>

  <view class="done-banner" wx:if="{{progress && progress.completed}}">
    <text class="done-text">🎉 三步全部完成，能量印记已自动发放</text>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>
</view>
