.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0fdf4 0%, #f5f7fa 100%);
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.slogan {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 32rpx;
  border: 2rpx solid #e8f7ee;
}

.slogan-text {
  font-size: 26rpx;
  color: #1f7a44;
  line-height: 1.7;
}

.medal-card {
  background: linear-gradient(160deg, #fff7e0 0%, #ffe8b3 100%);
  border-radius: 28rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 179, 0, 0.25);
  border: 2rpx solid #ffd54a;
}

.medal-card.pending {
  background: #ffffff;
  border-color: #e5e7eb;
  box-shadow: none;
}

.medal-ring {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: conic-gradient(#ffd54a, #ffb300, #ff8f00, #ffd54a);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(255, 179, 0, 0.4);
  margin-bottom: 28rpx;
}

.medal-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #fff8e6;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx dashed #ffd54a;
}

.pending-ring {
  background: #e5e7eb;
  box-shadow: none;
}

.pending-circle {
  background: #f9fafb;
  border-color: #d1d5db;
}

.medal-emoji {
  font-size: 72rpx;
}

.medal-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #5d3a00;
  margin-bottom: 12rpx;
}

.medal-code {
  font-size: 30rpx;
  color: #7a5400;
  font-family: monospace;
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
}

.medal-progress {
  background: rgba(255, 255, 255, 0.7);
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
}

.medal-progress-text {
  font-size: 24rpx;
  color: #7a5400;
}

.redeem-guide {
  margin-top: 32rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  border: 2rpx solid #e5e7eb;
}

.redeem-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 12rpx;
}

.redeem-text {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.7;
}

.loading {
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
  padding: 40rpx 0;
}
