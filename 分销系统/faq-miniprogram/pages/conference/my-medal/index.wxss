.page {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: 60rpx;
}

.theme {
  width: 100%;
  display: block;
}

.slogan {
  margin: 24rpx 32rpx 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.7;
}

.progress-bar-wrap {
  margin: 8rpx 32rpx 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.progress-text {
  font-size: 28rpx;
  color: #111827;
  font-weight: 600;
}

.progress-track {
  margin-top: 16rpx;
  height: 20rpx;
  background: #E5E7EB;
  border-radius: 10rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #00B050, #22c55e);
  border-radius: 10rpx;
  transition: width 0.3s;
}

.zone-card {
  margin: 0 32rpx 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
}

.zone-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 50%;
  border: 3rpx solid #d1d5db;
  color: #d1d5db;
  font-size: 40rpx;
  margin-right: 24rpx;
}

.zone-icon.claimed {
  background: #00B050;
  border-color: #00B050;
  color: #fff;
}

.zone-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.zone-name {
  font-size: 30rpx;
  color: #111827;
  font-weight: 600;
}

.zone-status {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

.medal-card {
  margin: 24rpx 32rpx;
  padding: 48rpx 32rpx;
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(245, 158, 11, 0.3);
}

.medal-badge {
  font-size: 88rpx;
}

.medal-title {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #78350f;
}

.medal-code {
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #92400e;
}

.medal-hint {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #78350f;
  line-height: 1.6;
}

.medal-pending {
  margin: 24rpx 32rpx;
  padding: 40rpx 32rpx;
  background: #fff;
  border-radius: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.7;
}

.ghost-btn {
  margin: 32rpx;
  background: #fff;
  color: #00B050;
  border: 2rpx solid #00B050;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.loading {
  text-align: center;
  color: #9ca3af;
  padding: 60rpx 0;
  font-size: 28rpx;
}

.empty {
  text-align: center;
  color: #9ca3af;
  padding: 80rpx 40rpx;
  font-size: 28rpx;
  line-height: 1.7;
}
