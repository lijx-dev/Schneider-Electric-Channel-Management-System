<view class="page">
  <view class="slogan">
    <text class="slogan-text">{{slogan}}</text>
  </view>

  <view class="medal-card" wx:if="{{medal && medal.granted}}">
    <view class="medal-ring">
      <view class="medal-circle">
        <text class="medal-emoji">🎖️</text>
      </view>
    </view>
    <text class="medal-title">能量勋章</text>
    <text class="medal-code">编号 {{medal.medal_code}}</text>
    <view class="medal-progress">
      <text class="medal-progress-text">已集齐 {{medal.earned_zones.length}}/{{medal.total_active_zones}} 个展区印记</text>
    </view>
  </view>

  <view class="medal-card pending" wx:if="{{medal && !medal.granted}}">
    <view class="medal-ring pending-ring">
      <view class="medal-circle pending-circle">
        <text class="medal-emoji">🔒</text>
      </view>
    </view>
    <text class="medal-title">尚未获得能量勋章</text>
    <view class="medal-progress">
      <text class="medal-progress-text">已集齐 {{medal.earned_zones.length}}/{{medal.total_active_zones}} 个展区印记，集齐后自动生成勋章</text>
    </view>
  </view>

  <view class="redeem-guide">
    <text class="redeem-title">兑换指引</text>
    <text class="redeem-text">{{redeemGuide}}</text>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>
</view>
