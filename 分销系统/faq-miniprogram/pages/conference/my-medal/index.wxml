<view class="page">
  <image class="theme" src="/images/conference/theme.jpg" mode="widthFix"></image>
  <view class="slogan">{{slogan}}</view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <block wx:elif="{{zones.length > 0}}">
    <!-- 总体进度 -->
    <view class="progress-bar-wrap">
      <text class="progress-text">已集齐 {{claimedCount}} / {{totalZones}} 枚能量印章</text>
      <view class="progress-track">
        <view class="progress-fill" style="width: {{totalZones ? (claimedCount / totalZones * 100) : 0}}%"></view>
      </view>
    </view>

    <!-- 打卡点印章状态 -->
    <view class="zone-card" wx:for="{{zones}}" wx:key="code">
      <view class="zone-icon {{item.claimed ? 'claimed' : ''}}">{{item.claimed ? '✓' : '○'}}</view>
      <view class="zone-info">
        <text class="zone-name">{{item.name}}</text>
        <text class="zone-status">{{item.claimed ? '已点亮印章' : '未完成'}}</text>
      </view>
    </view>

    <!-- 电子勋章（集齐时展示） -->
    <view class="medal-card" wx:if="{{medal.granted}}">
      <view class="medal-badge">🏅</view>
      <view class="medal-title">能量勋章</view>
      <view class="medal-code">{{medal.medal_code}}</view>
      <view class="medal-hint">{{redeemText}}</view>
    </view>

    <view class="medal-pending" wx:else>
      <text>继续前往各打卡点扫码答题，集齐 {{totalZones}} 枚印章即可点亮能量勋章</text>
    </view>

    <button class="ghost-btn" wx:if="{{canGoBack}}" bindtap="goBackToZone">返回打卡点</button>
  </block>

  <view wx:else class="empty">暂未获得任何印章，请扫码进入打卡点开始答题</view>
</view>
