.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 24rpx;
  padding-bottom: 160rpx;
}

.quiz-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 24rpx;
}

.quiz-header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
}

.quiz-header-progress {
  font-size: 24rpx;
  color: #00b050;
}

.question-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.question-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.question-index {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: #00b050;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
}

.question-type {
  font-size: 22rpx;
  color: #00b050;
  background: #f0fdf4;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.question-content {
  display: block;
  font-size: 28rpx;
  color: #1f2937;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.option-list {
  display: flex;
  flex-direction: column;
}

.option {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 14rpx;
  margin-bottom: 16rpx;
  transition: all 0.15s;
}

.option-active {
  border-color: #00b050;
  background: #f0fdf4;
}

.option-radio {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 3rpx solid #d1d5db;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.radio-active {
  border-color: #00b050;
  background: #00b050;
  box-shadow: inset 0 0 0 6rpx #ffffff;
}

.option-check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 3rpx solid #d1d5db;
  margin-right: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-active {
  border-color: #00b050;
  background: #00b050;
}

.check-mark {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.option-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
  margin-right: 16rpx;
}

.option-text {
  flex: 1;
  font-size: 26rpx;
  color: #374151;
}

.fill-wrap {
  margin-top: 8rpx;
}

.fill-input {
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.submit-btn {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 40rpx;
  background: #00b050;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 176, 80, 0.3);
}

.submit-btn[disabled] {
  background: #9ca3af;
  box-shadow: none;
}

.submit-tip {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9ca3af;
}
