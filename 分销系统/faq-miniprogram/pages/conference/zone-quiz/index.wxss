.page {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: 60rpx;
}

.theme {
  width: 100%;
  display: block;
}

.slogan {
  margin: 24rpx 32rpx 8rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.7;
}

.zone-name {
  margin: 0 32rpx 24rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #00B050;
}

.card {
  margin: 0 32rpx 24rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 16rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 24rpx;
}

.field {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.field-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #374151;
}

.field-input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  background: #F3F4F6;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.primary-btn {
  margin-top: 20rpx;
  background: #00B050;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.primary-btn[disabled] {
  background: #9ca3af;
  color: #fff;
}

.submit-btn {
  margin-top: 40rpx;
}

.question {
  margin-bottom: 36rpx;
}

.q-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.q-seq {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background: #00B050;
  color: #fff;
  border-radius: 50%;
  font-size: 26rpx;
  margin-right: 16rpx;
}

.q-type {
  font-size: 22rpx;
  color: #f59e0b;
  background: #fef3c7;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.q-content {
  font-size: 28rpx;
  color: #1f2937;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.option {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #F9FAFB;
  border: 2rpx solid #E5E7EB;
  border-radius: 12rpx;
  margin-bottom: 14rpx;
}

.option-check {
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border: 2rpx solid #9ca3af;
  border-radius: 50%;
  font-size: 24rpx;
  color: #6b7280;
  margin-right: 16rpx;
  background: #fff;
}

.option-check.checked {
  background: #00B050;
  border-color: #00B050;
  color: #fff;
}

.option-text {
  flex: 1;
  font-size: 27rpx;
  color: #374151;
  line-height: 1.5;
}

.fill-input {
  height: 80rpx;
  padding: 0 20rpx;
  background: #F3F4F6;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.loading {
  text-align: center;
  color: #9ca3af;
  padding: 60rpx 0;
  font-size: 28rpx;
}

.feedback {
  margin-top: 16rpx;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}
.feedback-mark.ok {
  color: #10B981;
  font-weight: 600;
}
.feedback-mark.no {
  color: #EF4444;
  font-weight: 600;
}
.feedback-answer {
  color: #4B5563;
}

.submit-tip {
  margin-top: 8rpx;
  padding: 8rpx 4rpx;
  color: #EF4444;
  font-size: 26rpx;
  text-align: center;
}
