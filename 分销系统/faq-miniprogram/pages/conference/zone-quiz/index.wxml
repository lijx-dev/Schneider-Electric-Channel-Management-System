<view class="page">
  <!-- 顶部主题图 + 宣传语 -->
  <image class="theme" src="/images/conference/theme.jpg" mode="widthFix"></image>
  <view class="slogan">{{slogan}}</view>
  <view class="zone-name" wx:if="{{zoneName}}">{{zoneName}}</view>

  <!-- 未签到：姓名＋手机号自助签到 -->
  <view class="card" wx:if="{{!signedIn}}">
    <view class="card-title">自助签到</view>
    <view class="field">
      <text class="field-label">姓名</text>
      <input class="field-input" placeholder="请输入姓名" value="{{name}}" bindinput="onInputName" />
    </view>
    <view class="field">
      <text class="field-label">手机号</text>
      <input class="field-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onInputPhone" />
    </view>
    <button class="primary-btn" bindtap="onSignIn">签到并开始答题</button>
  </view>

  <!-- 已签到：题目 -->
  <view class="card" wx:if="{{signedIn && !loading}}">
    <view class="card-title">完成以下题目，点亮本展区印章</view>

    <view class="question" wx:for="{{questions}}" wx:key="id" wx:for-item="q">
      <view class="q-head">
        <text class="q-seq">{{index + 1}}</text>
        <text class="q-type" wx:if="{{q.question_type === 'multiple_choice'}}">多选题</text>
        <text class="q-type" wx:elif="{{q.question_type === 'true_false'}}">判断题</text>
        <text class="q-type" wx:elif="{{q.question_type === 'fill_blank'}}">填空题</text>
      </view>
      <view class="q-content">{{q.content}}</view>

      <!-- 单选题/多选题：选项 -->
      <view class="option" wx:for="{{q.options}}" wx:key="label" wx:for-item="opt"
        wx:if="{{q.question_type === 'single_choice' || q.question_type === 'multiple_choice'}}"
        bindtap="onSelectOption"
        data-qid="{{q.id}}" data-label="{{opt.label}}" data-qtype="{{q.question_type}}">
        <view class="option-check {{opt.selected ? 'checked' : ''}}">{{opt.label}}</view>
        <text class="option-text">{{opt.text}}</text>
      </view>

      <!-- 判断题：选项 -->
      <view class="option" wx:for="{{q.options}}" wx:key="label" wx:for-item="opt"
        wx:if="{{q.question_type === 'true_false'}}"
        bindtap="onSelectOption"
        data-qid="{{q.id}}" data-label="{{opt.label}}" data-qtype="{{q.question_type}}">
        <view class="option-check {{opt.selected ? 'checked' : ''}}">{{opt.label}}</view>
        <text class="option-text">{{opt.text}}</text>
      </view>

      <!-- 填空题 -->
      <input class="fill-input" wx:if="{{q.question_type === 'fill_blank'}}" placeholder="请输入答案"
        data-qid="{{q.id}}" bindinput="onFillInput" />

      <!-- 提交后反馈：对错 + 正确答案 -->
      <view class="feedback" wx:if="{{q.feedback}}">
        <text class="feedback-mark {{q.feedback.is_correct ? 'ok' : 'no'}}">
          {{q.feedback.is_correct ? '✓ 答对' : '✗ 答错'}}
        </text>
        <text class="feedback-answer" wx:if="{{!q.feedback.is_correct}}">
          正确答案：{{q.feedback.correct_answer}}
        </text>
      </view>
    </view>

    <view class="submit-tip" wx:if="{{submitted && !allCorrect}}">
      答错的题目已标注，可修改后重新提交，次数不限。
    </view>

    <button class="primary-btn submit-btn" bindtap="onSubmit" disabled="{{submitting}}">
      {{submitting ? '提交中...' : (allCorrect ? '答题已完成' : '提交答案')}}
    </button>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>
</view>
