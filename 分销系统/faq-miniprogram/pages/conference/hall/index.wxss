.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 60rpx;
}

.banner {
  background: #ffffff;
}

.banner-img {
  width: 100%;
  display: block;
}

.slogan {
  padding: 24rpx 32rpx;
  background: linear-gradient(180deg, #e8f7ee 0%, #ffffff 100%);
}

.slogan-text {
  font-size: 26rpx;
  color: #1f7a44;
  line-height: 1.7;
}

.medal-entry {
  margin: 24rpx;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ffd54a 0%, #ffb300 100%);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 6rpx 16rpx rgba(255, 179, 0, 0.35);
}

.medal-entry-icon {
  font-size: 64rpx;
  margin-right: 20rpx;
}

.medal-entry-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.medal-entry-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #5d3a00;
}

.medal-entry-code {
  font-size: 22rpx;
  color: #7a5400;
  margin-top: 4rpx;
}

.medal-entry-arrow {
  font-size: 40rpx;
  color: #7a5400;
}

.zone-list {
  margin: 0 24rpx;
}

.zone-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.zone-index {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #00b050;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.zone-info {
  flex: 1;
}

.zone-name-row {
  display: flex;
  align-items: center;
}

.zone-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.zone-claim-badge {
  margin-left: 16rpx;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #6b7280;
}

.zone-claim-badge.claimed {
  background: #e8f7ee;
  color: #00b050;
}

.zone-slogan {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 8rpx;
}

.zone-meta {
  margin-top: 10rpx;
}

.zone-meta-text {
  font-size: 22rpx;
  color: #00b050;
  background: #f0fdf4;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.zone-arrow {
  font-size: 40rpx;
  color: #cbd5e1;
  margin-left: 16rpx;
}

.loading {
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
  padding: 40rpx 0;
}
