.page {
  min-height: 100vh;
  background: #F5F7FA;
  padding: 24rpx;
  box-sizing: border-box;
  padding-bottom: 48rpx;
}

/* 标题栏 */
.header {
  padding: 32rpx 0;
  text-align: center;
}
.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
  display: block;
}
.header-sub {
  font-size: 26rpx;
  color: #94a3b8;
  margin-top: 8rpx;
  display: block;
}

/* 模式切换标签 */
.mode-tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  gap: 8rpx;
}
.mode-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #64748B;
  font-weight: 500;
  transition: all 0.2s;
}
.mode-tab-active {
  background: #00B050;
  color: #FFFFFF;
  font-weight: 600;
}

/* 上传区域 */
.upload-area {
  background: #FFFFFF;
  border: 2rpx dashed #CBD5E1;
  border-radius: 16rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  margin-top: 0;
  transition: all 0.2s;
}
.upload-area:active {
  background: #F8FAFC;
  border-color: #00B050;
}
.upload-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}
.upload-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #334155;
  display: block;
  margin-bottom: 16rpx;
}
.upload-hint {
  font-size: 24rpx;
  color: #94a3b8;
  display: block;
  margin-top: 8rpx;
}

/* 加载中 */
.loading-area {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  margin-top: 0;
}
.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #E2E8F0;
  border-top-color: #00B050;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto 32rpx;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #334155;
  display: block;
}
.loading-file {
  font-size: 26rpx;
  color: #64748B;
  display: block;
  margin-top: 12rpx;
  word-break: break-all;
}
.loading-sub {
  font-size: 24rpx;
  color: #94a3b8;
  display: block;
  margin-top: 16rpx;
}

/* 错误 */
.error-area {
  background: #FEF2F2;
  border: 2rpx solid #FECACA;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  margin-top: 0;
  text-align: center;
}
.error-text {
  font-size: 28rpx;
  color: #DC2626;
  display: block;
  margin-bottom: 24rpx;
}

/* 结果区域 */
.result-area {
  margin-top: 0;
}

/* 风险卡片 */
.risk-card {
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  text-align: center;
}
.risk-high {
  background: linear-gradient(135deg, #FEF2F2, #FEE2E2);
  border: 2rpx solid #FECACA;
}
.risk-medium {
  background: linear-gradient(135deg, #FFFBEB, #FEF3C7);
  border: 2rpx solid #FDE68A;
}
.risk-low {
  background: linear-gradient(135deg, #F0FDF4, #DCFCE7);
  border: 2rpx solid #BBF7D0;
}
.risk-unknown {
  background: linear-gradient(135deg, #F8FAFC, #E2E8F0);
  border: 2rpx solid #CBD5E1;
}
.risk-label {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 16rpx;
}
.risk-high .risk-label { color: #DC2626; }
.risk-medium .risk-label { color: #D97706; }
.risk-low .risk-label { color: #16A34A; }
.risk-unknown .risk-label { color: #64748B; }
.risk-detail {
  font-size: 26rpx;
  color: #475569;
  line-height: 1.6;
}

/* 信息卡片 */
.info-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
}
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}
.info-row:last-child {
  border-bottom: none;
}
.info-label {
  font-size: 26rpx;
  color: #64748B;
}
.info-value {
  font-size: 26rpx;
  color: #334155;
  font-weight: 500;
}

/* 章节卡片 */
.section-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E293B;
  display: block;
  margin-bottom: 20rpx;
}
.section-desc {
  font-size: 26rpx;
  color: #64748B;
  line-height: 1.6;
}

/* 友商列表 */
.competitor-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.competitor-item {
  background: #FEF2F2;
  border-radius: 12rpx;
  padding: 20rpx;
}
.comp-brand {
  font-size: 28rpx;
  font-weight: 600;
  color: #DC2626;
  display: block;
  margin-bottom: 12rpx;
}
.comp-keywords {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.comp-kw {
  background: #FEE2E2;
  color: #B91C1C;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 施耐德关键词 */
.schneider-keywords {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.kw-tag {
  background: #DCFCE7;
  color: #166534;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

/* 投标资料要求 */
.requirement-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.requirement-item {
  background: #F8FAFC;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
}
.req-name {
  font-size: 26rpx;
  color: #334155;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}
.req-keywords {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}
.req-kw {
  background: #E0F2FE;
  color: #0369A1;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 章节列表 */
.section-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.section-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #F8FAFC;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
}
.section-name {
  font-size: 26rpx;
  color: #334155;
  font-weight: 500;
}
.section-location {
  font-size: 24rpx;
  color: #00B050;
  background: #F0FDF4;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 文件列表 */
.doc-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.doc-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #F8FAFC;
  padding: 20rpx;
  border-radius: 12rpx;
}
.doc-info {
  flex: 1;
}
.doc-name {
  font-size: 28rpx;
  color: #1E293B;
  font-weight: 500;
  display: block;
}
.doc-desc {
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 4rpx;
  display: block;
}
.doc-status {
  margin-left: 16rpx;
}
.doc-unavailable {
  font-size: 22rpx;
  color: #94A3B8;
  background: #F1F5F9;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.doc-hint {
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 16rpx;
  display: block;
  text-align: center;
}

/* ============================================================ */
/* 智能分析专用样式 */
/* ============================================================ */

/* 分析表格 */
.analysis-table {
  width: 100%;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid #E2E8F0;
}
.analysis-row {
  display: flex;
  border-bottom: 1rpx solid #F1F5F9;
}
.analysis-row:last-child {
  border-bottom: none;
}
.analysis-row-header {
  background: #F8FAFC;
}
.analysis-row-header .analysis-cell {
  font-weight: 600;
  color: #64748B;
  font-size: 24rpx;
}
.analysis-cell {
  padding: 16rpx 12rpx;
  font-size: 24rpx;
  color: #334155;
  line-height: 1.5;
  word-break: break-all;
}
.analysis-cell-name {
  width: 180rpx;
  flex-shrink: 0;
  font-weight: 500;
}
.analysis-cell-risk {
  width: 80rpx;
  flex-shrink: 0;
  text-align: center;
  font-weight: 600;
}
.analysis-cell-score {
  width: 100rpx;
  flex-shrink: 0;
  text-align: center;
  font-weight: 600;
  color: #00B050;
}
.analysis-cell-desc {
  flex: 1;
  min-width: 0;
}

/* 风险文本颜色 */
.risk-text-high {
  color: #DC2626 !important;
}
.risk-text-medium {
  color: #D97706 !important;
}
.risk-text-low {
  color: #16A34A !important;
}

/* 产品最佳匹配 */
.product-best {
  background: linear-gradient(135deg, #F0FDF4, #DCFCE7);
  border: 2rpx solid #BBF7D0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.product-best-label {
  background: #00B050;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.product-best-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #166534;
}
.product-best-text {
  color: #00B050 !important;
  font-weight: 700 !important;
}

/* 策略列表 */
.strategy-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.strategy-item {
  display: flex;
  gap: 12rpx;
  background: #F8FAFC;
  padding: 20rpx;
  border-radius: 12rpx;
  align-items: flex-start;
}
.strategy-index {
  font-size: 26rpx;
  font-weight: 700;
  color: #00B050;
  flex-shrink: 0;
  width: 36rpx;
}
.strategy-text {
  font-size: 26rpx;
  color: #334155;
  line-height: 1.6;
  flex: 1;
}

/* 按钮 */
.retry-btn {
  background: #00B050;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-top: 16rpx;
}
.retry-btn:active {
  background: #009940;
}

/* 使用说明 */
.tips-area {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-top: 0;
}
.tips-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E293B;
  display: block;
  margin-bottom: 20rpx;
}
.tips-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.tips-item {
  font-size: 26rpx;
  color: #64748B;
  line-height: 1.6;
}
.tips-warn {
  font-size: 24rpx;
  color: #D97706;
  margin-top: 20rpx;
  display: block;
  padding: 16rpx;
  background: #FFFBEB;
  border-radius: 8rpx;
}

/* 无品牌匹配 */
.no-brand {
  border: 2rpx dashed #CBD5E1;
}

/* 无权限页 */
.no-permission {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 80rpx 40rpx;
  margin-top: 0;
  text-align: center;
}
.permission-icon {
  font-size: 96rpx;
  margin-bottom: 32rpx;
}
.permission-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1E293B;
  display: block;
  margin-bottom: 16rpx;
}
.permission-desc {
  font-size: 26rpx;
  color: #94A3B8;
  display: block;
  line-height: 1.6;
}