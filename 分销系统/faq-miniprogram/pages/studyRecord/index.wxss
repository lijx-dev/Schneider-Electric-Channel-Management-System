.page {
  min-height: 100%;
  padding: 28rpx 24rpx 40rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top right, rgba(16, 185, 129, 0.18), transparent 32%),
    linear-gradient(180deg, #f5fbf8 0%, #f7f8fb 48%, #f4f6fa 100%);
}

.hero-card {
  padding: 34rpx 30rpx 32rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #0ea972 0%, #10b981 62%, #47d9ae 100%);
  box-shadow: 0 18rpx 46rpx rgba(16, 185, 129, 0.24);
}

.hero-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.hero-copy {
  flex: 1;
}

.hero-eyebrow {
  display: block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.75);
}

.hero-title {
  display: block;
  margin-top: 18rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #ffffff;
}

.hero-subtitle {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.82);
}

.today-chip {
  min-width: 152rpx;
  padding: 18rpx 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.16);
  text-align: center;
}

.today-chip-label {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.78);
}

.today-chip-value {
  display: block;
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
  color: #ffffff;
}

.section {
  margin-top: 28rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 0 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.section-subtitle {
  font-size: 22rpx;
  color: #94a3b8;
  text-align: right;
}

.core-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 18rpx;
}

.core-card,
.portrait-card,
.activity-card,
.record-card,
.record-empty {
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.06);
}

.core-card {
  padding: 28rpx 24rpx;
}

.core-label {
  display: block;
  font-size: 22rpx;
  color: #64748b;
}

.core-value-row {
  display: flex;
  align-items: baseline;
  margin-top: 16rpx;
}

.core-value {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
  color: #0f172a;
}

.core-suffix {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #10b981;
}

.activity-card {
  margin-top: 18rpx;
  padding: 28rpx 22rpx 24rpx;
}

.activity-empty {
  padding: 26rpx 20rpx;
  text-align: center;
}

.activity-empty-text {
  font-size: 24rpx;
  line-height: 1.7;
  color: #94a3b8;
}

.activity-chart {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 12rpx;
  min-height: 250rpx;
}

.activity-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.activity-count {
  margin-bottom: 14rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #10b981;
}

.activity-track {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  width: 100%;
  height: 148rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ecfdf5 0%, #f8fafc 100%);
}

.activity-bar {
  width: 34rpx;
  min-height: 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #34d399 0%, #10b981 100%);
  box-shadow: 0 8rpx 18rpx rgba(16, 185, 129, 0.25);
}

.activity-label {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #64748b;
}

.portrait-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 18rpx;
}

.portrait-card {
  padding: 26rpx 24rpx;
}

.portrait-label {
  display: block;
  font-size: 24rpx;
  color: #64748b;
}

.portrait-value {
  display: block;
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.1;
}

.portrait-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #94a3b8;
}

.record-list {
  margin-top: 18rpx;
}

.record-card {
  padding: 26rpx 26rpx 24rpx;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.record-card + .record-card {
  margin-top: 16rpx;
}

.record-top,
.record-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.record-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.record-tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  font-size: 20rpx;
  color: #64748b;
}

.record-tag.primary {
  background: #ecfdf5;
  color: #059669;
}

.record-score {
  font-size: 30rpx;
  font-weight: 700;
}

.record-question {
  display: block;
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #0f172a;
  white-space: normal;
  word-break: break-word;
}

.record-result,
.record-time {
  margin-top: 18rpx;
  font-size: 22rpx;
}

.record-time {
  color: #94a3b8;
}

.record-empty {
  margin-top: 18rpx;
  padding: 42rpx 30rpx;
  text-align: center;
}

.record-empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.record-empty-copy {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #94a3b8;
}

.is-correct {
  color: #10b981;
}

.is-wrong {
  color: #f97316;
}
