.cart-fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(5rpx + env(safe-area-inset-bottom));
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 156rpx;
  gap: 12rpx;
  padding: 18rpx 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #006b32 0%, #0ea972 100%);
  box-shadow: 0 16rpx 30rpx rgba(0, 107, 50, 0.24);
}

.cart-fab-badge {
  min-width: 38rpx;
  height: 38rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #ffffff;
  color: #006b32;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 38rpx;
  text-align: center;
}

.cart-fab-text {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.cart-fab-cost {
  color: rgba(255, 255, 255, 0.9);
  font-size: 20rpx;
  line-height: 1;
}
