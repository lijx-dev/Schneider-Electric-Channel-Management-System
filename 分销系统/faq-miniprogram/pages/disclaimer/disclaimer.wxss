page {
  background: #f5f7fa;
  min-height: 100vh;
}

.page {
  padding: 48rpx 32rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
}

.header-subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #999999;
}

.notice {
  background: rgba(0, 176, 80, 0.08);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
}

.notice-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #00b050;
  margin-bottom: 12rpx;
}

.notice-content {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.7;
  font-weight: 500;
}

.terms {
  display: flex;
  flex-direction: column;
}

.terms-item {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.7;
  margin-bottom: 10rpx;
}

.agree-row {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  padding: 12rpx 0;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #cccccc;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  box-sizing: border-box;
}

.checkbox-checked {
  background: #00b050;
  border-color: #00b050;
}

.checkbox-mark {
  font-size: 26rpx;
  color: #ffffff;
}

.agree-label {
  font-size: 28rpx;
  color: #333333;
}

.actions {
  display: flex;
  margin-top: 40rpx;
  gap: 24rpx;
}

.btn {
  flex: 1;
  height: 92rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.btn-primary {
  background: #00b050;
  color: #ffffff;
}

.btn-secondary {
  background: #ffffff;
  color: #666666;
  border: 2rpx solid #dddddd;
}