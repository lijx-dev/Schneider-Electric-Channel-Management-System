<view class="flex-col page">
  <view class="flex-col justify-start items-center self-center image-wrapper">
    <image
      class="image"
      src="../../images/home_active.jpg"
      mode="aspectFit"
    />
  </view>

  <view class="flex-col items-start self-stretch group">
    <text class="text">Distributor Academy</text>
    <text class="font text_2 mt-9">分销商学堂</text>
  </view>

  <view class="flex-col self-stretch group_2">
    <button
      class="flex-row justify-center items-center self-center section login-button"
      open-type="getPhoneNumber"
      bindgetphonenumber="getPhoneNumber"
    >
      <text class="login-glyph"></text>
      <text class="ml-8 font text_3">手机号一键登录</text>
    </button>

    <button
      class="flex-row justify-center items-center self-center account-login-toggle"
      bindtap="togglePasswordLogin"
    >
      <text class="font account-login-text">账号密码登录</text>
    </button>

    <view class="account-login-panel" wx:if="{{showPasswordLogin}}">
      <input
        class="account-input"
        value="{{username}}"
        placeholder="请输入账号"
        placeholder-class="account-input-placeholder"
        bindinput="onUsernameInput"
      />
      <input
        class="account-input"
        value="{{password}}"
        password
        placeholder="请输入密码"
        placeholder-class="account-input-placeholder"
        bindinput="onPasswordInput"
      />
      <button class="account-submit" bindtap="doPasswordLogin">登录</button>
    </view>

    <text class="mt-28 self-center font text_4" bindtap="cancelLogin">暂不登录</text>
  </view>

  <view class="flex-row justify-center items-center self-stretch group_3">
    <view class="checkbox {{agreed ? 'checked' : ''}}" bindtap="toggleAgree">
      <text class="checkbox-icon" wx:if="{{agreed}}">✓</text>
    </view>
    <view class="ml-8 group_4">
      <text class="font_2 text_5" bindtap="toggleAgree">我已阅读并同意</text>
      <text class="font_3" data-type="terms" bindtap="showPolicy">《服务协议》</text>
      <text class="font_2 text_6">与</text>
      <text class="font_3 text_7" data-type="privacy" bindtap="showPolicy">《隐私政策》</text>
    </view>
  </view>
</view>
