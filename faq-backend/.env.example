# ==================== Basic Config ====================
PROJECT_NAME=faq-system
DEBUG=false
ENVIRONMENT=development

# ==================== Database ====================
# Supported DB modes: mysql | sqlite | memory
# - mysql:  use DATABASE_URL below for staging/production
# - sqlite: local faq_dev.db file for persistent local development
# - memory: in-memory SQLite for lightweight local testing
DB_TYPE=sqlite

# Example production MySQL DSN:
DATABASE_URL=mysql+aiomysql://username:password@host:3306/database

# For MySQL deployments, run the released Alembic migrations before starting the app:
# python -m alembic -c alembic.ini upgrade head
# The app startup path now only verifies connectivity and Alembic head.
SECRET_KEY=your-production-secret-key-here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
ADMIN_SECRET_KEY=change-this-admin-secret

# ==================== WeChat ====================
WECHAT_APPID=your-wechat-appid
WECHAT_SECRET=your-wechat-secret
WECHAT_SSL_VERIFY=true
# Optional custom CA bundle path inside the container, for example:
# /etc/ssl/certs/ca-certificates.crt
WECHAT_CA_BUNDLE=
# Ignore proxy env vars by default to avoid unexpected TLS interception.
WECHAT_HTTP_TRUST_ENV=false

# ==================== HiAgent AI ====================
HIAGENT_API_BASE=https://hiagent-stg.schneider-electric.cn/api/proxy/api/v1
HIAGENT_API_KEY=your-hiagent-api-key

# ==================== Storage ====================
# local: local filesystem
# cos:   Tencent COS / object storage for production
STORAGE_BACKEND=cos
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_SESSION_TOKEN=
COS_REGION=ap-shanghai
COS_BUCKET=7465-test-8gwkg5zb84a8b224-1407839340
# Optional. If omitted, the app builds:
# https://{bucket}.cos.{region}.myqcloud.com
COS_BASE_URL=

# ==================== CORS ====================
# Production: restrict this to your allowed domains.
CORS_ORIGINS=https://servicewechat.com
